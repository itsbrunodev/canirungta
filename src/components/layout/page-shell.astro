---
// Every page's <main>: same width, safe-area padding, section rhythm and footer.
import SiteFooter from "@/components/layout/site-footer.astro";
---

<main
	id="main"
	class="relative mx-auto flex min-h-dvh max-w-6xl flex-col gap-12 pt-[max(3rem,env(safe-area-inset-top))] pr-[max(1rem,env(safe-area-inset-right))] pb-[max(2rem,env(safe-area-inset-bottom))] pl-[max(1rem,env(safe-area-inset-left))] sm:gap-16 sm:px-6 sm:pt-[max(4rem,env(safe-area-inset-top))] lg:px-8"
>
	<slot />
	<SiteFooter />
</main>
