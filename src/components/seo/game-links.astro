---
// Crawlable links to every game page; used on the homepage and each game page.
import SeoSection from "@/components/seo/seo-section.astro";

import { GAME_PAGES } from "@/constants/gta/game-pages";
import { CHIP_LINK_CLASS } from "@/constants/seo/table-styles";

import { ChevronDownIcon } from "@/icons/chevron-down";

interface Props {
	current?: string;
}

const { current } = Astro.props;
const links = [
	...GAME_PAGES.filter((page) => page.slug !== current).map((page) => ({
		href: `/${page.slug}`,
		label: `Can I run ${page.shortName}?`,
	})),
	...(current ? [{ href: "/", label: "All GTA games" }] : []),
];
---

<SeoSection as="nav" id="game-links" title={current ? "Check another GTA game" : "Check a specific game"}>
	<ul class="flex flex-wrap gap-2">
		{
			links.map((link) => (
				<li>
					<a class={`group ${CHIP_LINK_CLASS} pr-2.5`} href={link.href}>
						{link.label}
						<ChevronDownIcon class="size-3.5 shrink-0 -rotate-90 transition-[translate] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0.5" />
					</a>
				</li>
			))
		}
	</ul>
</SeoSection>
