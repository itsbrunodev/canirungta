---
// Crawlable links to every game page; used on the homepage and each game page.
import { GAME_PAGES } from "@/constants/gta/game-pages";

interface Props {
	current?: string;
}

const { current } = Astro.props;
const pages = GAME_PAGES.filter((page) => page.slug !== current);
---

<nav aria-labelledby="game-links" class="w-full">
	<h2 id="game-links" class="text-foreground text-xl font-semibold tracking-tight sm:text-3xl">
		{current ? "Check another GTA game" : "Check a specific game"}
	</h2>
	<ul class="mt-4 flex flex-wrap gap-2">
		{
			pages.map((page) => (
				<li>
					<a class="glass text-foreground hover:text-accent inline-flex h-10 items-center rounded-full px-4 text-sm font-medium" href={`/${page.slug}`}>
						Can I run {page.shortName}?
					</a>
				</li>
			))
		}
		{current && (
			<li>
				<a class="glass text-foreground hover:text-accent inline-flex h-10 items-center rounded-full px-4 text-sm font-medium" href="/">All GTA games</a>
			</li>
		)}
	</ul>
</nav>
