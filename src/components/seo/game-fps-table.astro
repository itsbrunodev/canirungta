---
import { FPS_RATING_STYLES } from "@/constants/gta/fps-rating-styles";
import type { GamePage } from "@/constants/gta/game-pages";

import type { FpsTable } from "@/lib/seo/build-fps-table";

interface Props {
	game: GamePage;
	table: FpsTable;
	projected: boolean;
}

const { game, table, projected } = Astro.props;
---

<section aria-labelledby="fps" class="w-full">
	<h2 id="fps" class="text-foreground text-xl font-semibold tracking-tight sm:text-3xl">
		{game.shortName} FPS by graphics card
	</h2>
	<p class="text-muted-foreground mt-2 text-sm">
		Estimated average FPS on {table.presetLabel} settings with a {table.cpu} and {table.ramGb} GB RAM.
		{projected ? " Projected from unofficial specs: a rough guide, not a benchmark." : " Modelled from published benchmarks, not measured on your PC."}
		Your own result above uses your actual hardware.
	</p>
	<div class="mt-6 overflow-x-auto">
		<table class="w-full min-w-[26rem] border-collapse text-left text-sm">
			<caption class="sr-only">Estimated {game.shortName} FPS per graphics card at {table.resolutions.map((r) => r.label).join(", ")}</caption>
			<thead class="text-muted-foreground border-border border-b">
				<tr>
					<th scope="col" class="py-2 pr-4 font-medium">Graphics card</th>
					{table.resolutions.map((r) => <th scope="col" class="py-2 pr-4 font-medium">{r.label}</th>)}
				</tr>
			</thead>
			<tbody class="divide-border divide-y">
				{
					table.rows.map((row) => (
						<tr>
							<th scope="row" class="text-foreground py-2 pr-4 font-medium">{row.gpu}</th>
							{row.cells.map((cell) => (
								<td class={`py-2 pr-4 whitespace-nowrap tabular-nums ${cell?.rating ? FPS_RATING_STYLES[cell.rating].textClassName : "text-muted-foreground"}`}>
									{cell?.fps != null ? `${cell.fps} FPS` : "n/a"}
								</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>
