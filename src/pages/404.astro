---
import PageHero from "@/components/layout/page-hero.astro";
import PageShell from "@/components/layout/page-shell.astro";
import GameLinks from "@/components/seo/game-links.astro";

import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
	title="Page not found | Can I run GTA?"
	description="This page does not exist."
	noindex
>
	<PageShell>
		<PageHero back>
			<Fragment slot="title">Page not found</Fragment>
			<Fragment slot="intro">This page doesn't exist, or it has moved.</Fragment>
			<p slot="note">Pick a game below, or go back to the checker for every GTA version.</p>
		</PageHero>
		<GameLinks />
	</PageShell>
</BaseLayout>
