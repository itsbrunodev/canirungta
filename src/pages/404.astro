---
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
	title="Page not found | Can I run GTA?"
	description="This page does not exist."
	noindex
>
	<main
		id="main"
		class="mx-auto grid min-h-dvh max-w-3xl place-items-center px-4 py-[max(2rem,env(safe-area-inset-top))]"
	>
		<div class="flex flex-col items-center gap-4 text-center">
			<h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
			<p class="text-muted-foreground">This page doesn't exist.</p>
			<a
				href="/"
				class="glass text-foreground hover:border-accent/40 hover:text-accent focus-visible:outline-primary mt-2 inline-flex h-11 items-center rounded-full px-6 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
				>Back to Can I run GTA?</a
			>
		</div>
	</main>
</BaseLayout>
