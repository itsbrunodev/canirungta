---
import { SystemCheck } from "@/components/gta/system-check";
import SiteFooter from "@/components/layout/site-footer.astro";
import ThemeToggle from "@/components/layout/theme-toggle.astro";

import { getGtaCovers } from "@/lib/gta/get-covers";
import type { CoverImage } from "@/lib/gta/types";
import { buildStructuredData } from "@/lib/seo/build-structured-data";

import BaseLayout from "@/layouts/base-layout.astro";

const pageTitle = "Can I run GTA? Check every PC version of Grand Theft Auto";
const pageDescription =
	"Check whether your PC can run every PC version of Grand Theft Auto, from GTA III to GTA V Enhanced, against its published minimum requirements. Free, runs in your browser.";

const covers = await getGtaCovers();

// Static 1200x630 card in public/, the size social platforms expect for large link previews.
const share: CoverImage = {
	src: "/og.png",
	width: 1200,
	height: 630,
	alt: "Can I run GTA? Check every PC version of Grand Theft Auto against your PC",
};

const structuredData = buildStructuredData({
	siteUrl: Astro.site?.href ?? "https://canirungta.com/",
	description: pageDescription,
	imageUrl: new URL(share.src, Astro.site).href,
});
---

<BaseLayout title={pageTitle} description={pageDescription} image={share}>
	<main id="main" class="relative mx-auto flex min-h-dvh max-w-6xl flex-col gap-12 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] pt-[max(3rem,env(safe-area-inset-top))] sm:pt-[max(4rem,env(safe-area-inset-top))] pb-[max(2rem,env(safe-area-inset-bottom))] sm:gap-16 sm:px-6 lg:px-8">
		<div class="absolute top-[max(0.75rem,env(safe-area-inset-top))] right-[max(0.75rem,env(safe-area-inset-right))] sm:top-4 sm:right-6">
			<ThemeToggle />
		</div>
		<header class="mx-auto my-6 flex max-w-3xl sm:my-10 flex-col gap-4 text-center">
			<h1 class="text-4xl font-bold tracking-tight min-[420px]:text-5xl lg:text-6xl">
				Can I run {" "}
				<span
					class="-mx-1 -my-1 inline-block bg-linear-to-br px-1 py-1 from-gta-from via-primary to-accent bg-clip-text text-transparent"
					>GTA</span
				>?
			</h1>
			<p class="text-foreground text-lg sm:text-xl">
				See whether your PC meets the minimum requirements for every PC version
				of Grand Theft Auto, from GTA III to GTA V Enhanced.
			</p>
			<p class="text-muted-foreground text-balance">
				Checks run in your browser. Run the optional system probe for exact
				figures.
			</p>
		</header>
		<SystemCheck client:load covers={covers} />
		<!-- Results need JavaScript; no-JS readers and crawlers get the data and the API instead. -->
		<noscript>
			<p class="text-muted-foreground text-center text-sm">
				This checker needs JavaScript. The full requirements are at
				<a class="underline" href="/requirements.md">/requirements.md</a>, and
				specs can be checked through the API described in
				<a class="underline" href="/llms.txt">/llms.txt</a>.
			</p>
		</noscript>
		<SiteFooter />
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
