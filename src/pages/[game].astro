---
import { existsSync } from "node:fs";
import { join } from "node:path";

import { SystemCheck } from "@/components/gta/system-check";
import PageShell from "@/components/layout/page-shell.astro";
import GameFaq from "@/components/seo/game-faq.astro";
import GameFpsSection from "@/components/seo/game-fps-section.astro";
import GameHeader from "@/components/seo/game-header.astro";
import GameLinks from "@/components/seo/game-links.astro";
import GameRequirements from "@/components/seo/game-requirements.astro";

import { GAME_PAGES } from "@/constants/gta/game-pages";

import { getGtaCovers } from "@/lib/gta/get-covers";
import type { CoverImage } from "@/lib/gta/types";
import { buildGameEditions } from "@/lib/seo/build-game-editions";
import { buildGameFaq } from "@/lib/seo/build-game-faq";
import { buildGameStructuredData } from "@/lib/seo/build-game-structured-data";
import type { GamePage } from "@/lib/seo/game-page-types";

import BaseLayout from "@/layouts/base-layout.astro";

export function getStaticPaths() {
	return GAME_PAGES.map((game) => ({
		params: { game: game.slug },
		props: { game },
	}));
}

interface Props {
	game: GamePage;
}

const { game } = Astro.props;
const editions = buildGameEditions(game);
const versions = editions.map((edition) => edition.version);
const covers = await getGtaCovers();
const faq = buildGameFaq(game, editions);

// Per-game card from public/og/<slug>.png when it exists, else the shared one. cwd is the
// project root at build time; import.meta.url would point into the build output instead.
const hasOwnCard = existsSync(
	join(process.cwd(), "public", "og", `${game.slug}.png`),
);
const share: CoverImage = {
	src: hasOwnCard ? `/og/${game.slug}.png` : "/og.png",
	width: 1200,
	height: 630,
	alt: `${game.h1} PC requirements and FPS checker`,
};

const siteUrl = Astro.site?.href ?? "https://canirungta.com/";
const structuredData = buildGameStructuredData({
	siteUrl,
	game,
	versions,
	faq,
	imageUrl: new URL(share.src, siteUrl).href,
});
---

<BaseLayout title={game.title} description={game.description} keywords={game.keywords} image={share}>
	<PageShell>
		<GameHeader game={game} />
		<SystemCheck client:idle covers={covers} versionIds={game.versionIds} />
		<GameRequirements game={game} versions={versions} />
		<GameFpsSection game={game} editions={editions} />
		<GameFaq shortName={game.shortName} items={faq} />
		<GameLinks current={game.slug} />
		<noscript>
			<p class="text-muted-foreground text-center text-sm">
				The checker needs JavaScript. Requirements are listed above and in
				<a class="underline" href="/requirements.md">/requirements.md</a>.
			</p>
		</noscript>
	</PageShell>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
