#!/bin/sh
# canirungta system probe for Linux, macOS, BSD (and WSL / Git Bash via the Windows host).
# Read-only: no installs, no writes. Sends only hardware facts, no hostname or user names.
# Usage: curl -fsSL https://canirungta.com/sh | sh
# Prints what it found, then asks before opening the result in a browser.
# Set CANIRUNGTA_NO_OPEN=1 to print the result link without asking or opening.
# Set CANIRUNGTA_ORIGIN to point at another site (dev: http://localhost:4321).

# Whole script is wrapped in main() and called last, so a truncated download runs nothing.
ORIGIN="${CANIRUNGTA_ORIGIN:-https://canirungta.com}"

json_str() {
	printf '"%s"' "$(printf '%s' "$1" | tr -d '\001-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# Empty means unknown; prints JSON null.
json_str_or_null() {
	if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi
}

json_num_or_null() {
	case "$1" in
		'' | *[!0-9]*) printf 'null' ;;
		*) printf '%s' "$1" ;;
	esac
}

# The link carries MiB, not bytes: same precision for the checks, fewer digits in the URL.
mib_or_null() {
	case "$1" in
		'' | *[!0-9]*) printf 'null' ;;
		*) printf '%s' $(($1 / 1048576)) ;;
	esac
}

# Probes write these globals; emit_json serializes them.
OS_FAMILY=""
OS_NAME=""
CPU_CORES=""
CPU_MODEL=""
CPU_PHYSICAL=""
CPU_MHZ=""
MEM_BYTES=""
RAM_MHZ=""
RAM_TYPE=""
GPUS_JSON=""
DISKS_JSON=""
# Human-readable lines for the terminal summary, built alongside the JSON.
GPUS_TEXT=""
DISKS_TEXT=""
UNIFIED_MEMORY="false"
VULKAN_JSON="null"

fmt_gb() { # bytes -> "32 GB" or "512 MB", "unknown" when not a number
	case "$1" in
		'' | *[!0-9]*) printf 'unknown' ;;
		*) awk -v b="$1" 'BEGIN {
			g = b / 1073741824
			if (g < 1) { printf "%d MB", int(g * 1024 + 0.5); exit }
			r = int(g * 10 + 0.5) / 10
			if (r == int(r)) printf "%d GB", r; else printf "%.1f GB", r
		}' ;;
	esac
}

add_gpu() { # name, vram bytes, integrated (true/false), driver
	integrated=0
	if [ "${3:-false}" = true ]; then integrated=1; fi
	entry=$(printf '[%s,%s,%s,%s]' "$(json_str_or_null "$1")" "$(mib_or_null "$2")" "$integrated" \
		"$(json_str_or_null "$4")")
	if [ -n "$GPUS_JSON" ]; then
		GPUS_JSON="$GPUS_JSON,$entry"
	else
		GPUS_JSON=$entry
	fi

	detail=""
	if [ -n "$2" ]; then detail="$(fmt_gb "$2") VRAM"; fi
	if [ "$integrated" = 1 ]; then detail="${detail:+$detail, }integrated"; fi
	if [ -n "$4" ]; then detail="${detail:+$detail, }driver $4"; fi
	GPUS_TEXT="$GPUS_TEXT$(printf '  %-8s%s%s' GPU "${1:-unknown}" "${detail:+ ($detail)}")
"
}

# Mirrors emit_json: everything printed here is exactly what goes into the link.
print_summary() {
	echo "canirungta probe (nothing is sent until you open the link; the data stays in the URL fragment)"
	echo
	printf '  %-8s%s\n' OS "${OS_NAME:-unknown}"
	cpu_detail="${CPU_CORES:-?} threads"
	if [ -n "$CPU_PHYSICAL" ]; then cpu_detail="$CPU_PHYSICAL cores / $cpu_detail"; fi
	if [ -n "$CPU_MHZ" ]; then
		cpu_detail="$cpu_detail, up to $(awk -v m="$CPU_MHZ" 'BEGIN { printf "%.1f", m / 1000 }') GHz"
	fi
	printf '  %-8s%s (%s)\n' CPU "${CPU_MODEL:-unknown}" "$cpu_detail"
	mem="$(fmt_gb "$MEM_BYTES")"
	if [ -n "$RAM_TYPE" ]; then mem="$mem $RAM_TYPE"; fi
	if [ -n "$RAM_MHZ" ]; then mem="$mem $RAM_MHZ MHz"; fi
	if [ "$UNIFIED_MEMORY" = true ]; then mem="$mem (unified with GPU)"; fi
	printf '  %-8s%s\n' RAM "$mem"
	printf '%s' "$GPUS_TEXT"
	printf '%s' "$DISKS_TEXT"
	case "$VULKAN_JSON" in
		true) vk=yes ;;
		false) vk=no ;;
		*) vk="not tested" ;;
	esac
	printf '  %-8s%s\n' Vulkan "$vk"
	echo
}

# Needs a real terminal: under `curl | sh` stdin is the script, so ask via /dev/tty.
confirm_open() {
	( : </dev/tty ) 2>/dev/null || return 1
	printf 'Open result in browser? [Y/n] ' >/dev/tty
	read -r answer </dev/tty || return 1
	case "$answer" in
		n | N | no | NO | No) return 1 ;;
	esac
	return 0
}

# Positional array, version 4: [4, family letter, OS name, Windows major, 64-bit flag,
# RAM MiB, unified, logical cores, [[gpu name, VRAM MiB, integrated, driver]],
# [[free MiB, "s"|"h"|null, total MiB, label]], vulkan, CPU model, physical cores, max MHz, RAM MHz, RAM type].
# Windows major/bitness are only meaningful on Windows, so they stay null here.
emit_json() {
	family=$(printf '%s' "$OS_FAMILY" | cut -c1)
	unified=0
	if [ "$UNIFIED_MEMORY" = true ]; then unified=1; fi
	printf '[4,%s,%s,null,null,%s,%s,%s,[%s],[%s],%s,%s,%s,%s,%s,%s]' \
		"$(json_str_or_null "$family")" "$(json_str_or_null "$OS_NAME")" \
		"$(mib_or_null "$MEM_BYTES")" "$unified" \
		"$(json_num_or_null "$CPU_CORES")" "$GPUS_JSON" "$DISKS_JSON" "$VULKAN_JSON" \
		"$(json_str_or_null "$CPU_MODEL")" "$(json_num_or_null "$CPU_PHYSICAL")" \
		"$(json_num_or_null "$CPU_MHZ")" \
		"$(json_num_or_null "$RAM_MHZ")" "$(json_str_or_null "$RAM_TYPE")"
}

# SSD or HDD for a block device path; prints nothing when unknown. Linux walks partition -> disk
# (and LVM/dm -> its first backing device) to /sys/.../queue/rotational; macOS asks diskutil.
disk_kind() {
	dev=$1
	case "$dev" in /dev/*) ;; *) return 0 ;; esac
	case "$(uname -s 2>/dev/null)" in
		Darwin)
			solid=$(diskutil info "$dev" 2>/dev/null | awk -F': *' '/Solid State/ { print $2; exit }')
			case "$solid" in Yes) echo ssd ;; No) echo hdd ;; esac
			return 0
			;;
		Linux) ;;
		*) return 0 ;;
	esac

	name=$(basename "$(readlink -f "$dev")")
	depth=0
	while [ "$depth" -lt 4 ]; do
		sys=$(readlink -f "/sys/class/block/$name" 2>/dev/null)
		[ -n "$sys" ] || return 0
		# A partition's sysfs dir sits under its disk; a disk's own dir sits under "block".
		parent=$(basename "$(dirname "$sys")")
		if [ "$parent" != block ]; then name=$parent; fi
		backing=$(ls "/sys/class/block/$name/slaves" 2>/dev/null | head -n 1)
		[ -n "$backing" ] || break
		name=$backing
		depth=$((depth + 1))
	done

	case "$(cat "/sys/class/block/$name/queue/rotational" 2>/dev/null)" in
		0) echo ssd ;;
		# Virtual disks claim to spin even when the host stores them on flash.
		1) grep -qw hypervisor /proc/cpuinfo 2>/dev/null || echo hdd ;;
	esac
}

# Every local volume, since the game may be installed off $HOME's drive. Full mount paths are not
# sent (they can contain user names); the label is only the mount's last folder. $HOME's volume always counts; other rows must be real block devices.
# Rows are deduped on size+free, which also collapses bind mounts and APFS volumes sharing a container.
collect_disks() {
	# One df run, so a volume cannot show up twice with free space that shifted between two calls.
	home_mount=$(df -Pk "$HOME" 2>/dev/null | awk 'NR == 2 { print $NF }')
	rows=$(df -Pk 2>/dev/null | awk -v home="$home_mount" '
		NR > 1 {
			ok = ($NF == home) || ($1 ~ "^/dev/" && $1 !~ "^/dev/loop" && $NF !~ "^/(boot|efi|snap|private|System/Volumes/(VM|Preboot|Update|xarts|iSCPreboot|Hardware))")
			key = $2 ":" $4
			if (ok && !(key in seen)) { seen[key] = 1; print $4 * 1024 "|" $2 * 1024 "|" $1 "|" $NF }
		}')
	while IFS='|' read -r free total dev mount; do
		[ -n "$free" ] || continue
		kind=$(disk_kind "$dev")
		case "$kind" in
			ssd) kind_json='"s"'; label=" SSD" ;;
			hdd) kind_json='"h"'; label=" HDD" ;;
			*) kind_json=null; label="" ;;
		esac
		case "$mount" in
			/) name=System ;;
			"$home_mount") name=Home ;;
			*) name=$(basename "$mount") ;;
		esac
		entry=$(printf '[%s,%s,%s,%s]' "$(mib_or_null "$free")" "$kind_json" "$(mib_or_null "$total")" "$(json_str_or_null "$name")")
		if [ -n "$DISKS_JSON" ]; then DISKS_JSON="$DISKS_JSON,$entry"; else DISKS_JSON=$entry; fi
		DISKS_TEXT="$DISKS_TEXT$(printf '  %-8s%s free of %s%s (%s)' Disk "$(fmt_gb "$free")" "$(fmt_gb "$total")" "$label" "$name")
"
	done <<EOF
$rows
EOF
}

# nvidia-smi matches a card by PCI bus id (case-insensitive suffix), so two NVIDIA cards never swap
# figures. Prints "VRAM bytes|driver version", nothing when the tool or the card is missing.
nvidia_info() { # PCI slot like 0000:01:00.0
	command -v nvidia-smi >/dev/null 2>&1 || return 0
	nvidia-smi --query-gpu=pci.bus_id,memory.total,driver_version --format=csv,noheader,nounits 2>/dev/null |
		awk -F', *' -v s="${1#*:}" '{
			id = tolower($1); n = length(s)
			if (substr(id, length(id) - n + 1) == s) { printf "%.0f|%s\n", $2 * 1048576, $3; exit }
		}'
}

collect_linux_gpus() {
	# Walk DRM cards: gives VRAM for amdgpu, driver name for all. Connector entries like card0-DP-1 have no vendor file.
	for dev in /sys/class/drm/card[0-9]*/device; do
		[ -f "$dev/vendor" ] || continue
		slot=$(basename "$(readlink -f "$dev")")
		name=$(lspci -s "$slot" -mm 2>/dev/null | awk -F'"' '{ print $4 " " $6 }')
		driver=$(basename "$(readlink -f "$dev/driver" 2>/dev/null)")
		vram=$(cat "$dev/mem_info_vram_total" 2>/dev/null)
		driver_label=$driver
		if [ "$driver" = nvidia ]; then
			info=$(nvidia_info "$slot")
			if [ -n "$info" ]; then
				[ -n "$vram" ] || vram=${info%%|*}
				driver_label=${info#*|}
			fi
		fi
		# Integrated GPUs sit on PCI bus 0; discrete cards (Intel Arc included) hang off a bridge.
		integrated=false
		case "$slot" in ????:00:*) integrated=true ;; esac
		add_gpu "$name" "$vram" "$integrated" "$driver_label"
	done

	# No DRM nodes (containers, minimal setups): fall back to lspci names only.
	if [ -z "$GPUS_JSON" ] && command -v lspci >/dev/null 2>&1; then
		lines=$(lspci -mm 2>/dev/null | grep -Ei 'VGA|3D|Display')
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			name=$(printf '%s\n' "$line" | awk -F'"' '{ print $4 " " $6 }')
			add_gpu "$name" "" false ""
		done <<EOF
$lines
EOF
	fi
}

vulkan_probe() {
	if ! command -v vulkaninfo >/dev/null 2>&1; then
		VULKAN_JSON="null"
	elif vulkaninfo --summary >/dev/null 2>&1; then
		VULKAN_JSON="true"
	else
		VULKAN_JSON="false"
	fi
}

# Physical cores and top clock from lscpu, sysfs and /proc/cpuinfo.
linux_cpu_details() {
	CPU_PHYSICAL=$(lscpu -p=CORE,SOCKET 2>/dev/null | grep -v '^#' | sort -u | wc -l | tr -d ' ')
	if [ -z "$CPU_PHYSICAL" ] || [ "$CPU_PHYSICAL" = 0 ]; then
		CPU_PHYSICAL=$(awk -F': ' '/^physical id/ { p = $2 } /^core id/ { seen[p ":" $2] = 1 } END { n = 0; for (k in seen) n++; if (n) print n }' /proc/cpuinfo 2>/dev/null)
	fi
	khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null)
	if [ -n "$khz" ]; then
		CPU_MHZ=$((khz / 1000))
	else
		CPU_MHZ=$(lscpu 2>/dev/null | awk -F': *' '/CPU max MHz/ { print int($2); exit }')
	fi
}

probe_linux() {
	OS_FAMILY="linux"
	OS_NAME=$(. /etc/os-release 2>/dev/null && printf '%s' "$PRETTY_NAME")
	CPU_CORES=$(nproc 2>/dev/null)
	CPU_MODEL=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo 2>/dev/null)
	MEM_BYTES=$(awk '/^MemTotal:/ { print $2 * 1024 }' /proc/meminfo 2>/dev/null)
	linux_cpu_details
	collect_disks
	collect_linux_gpus
	vulkan_probe
}

# Under Rosetta, machdep.cpu.brand_string reads "VirtualApple @ 2.50GHz", so Apple Silicon asks
# system_profiler for the real chip ("Apple M2 Pro"). Intel Macs keep the sysctl string, which
# carries the full model number.
mac_cpu_model() {
	if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
		chip=$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/^ *Chip:/ { print $2; exit }')
		if [ -n "$chip" ]; then
			printf '%s' "$chip"
			return
		fi
	fi
	sysctl -n machdep.cpu.brand_string 2>/dev/null
}

# Intel Macs list DDR type and speed; Apple Silicon lists only an LPDDR type.
mac_ram_details() {
	mem=$(system_profiler SPMemoryDataType 2>/dev/null)
	RAM_TYPE=$(printf '%s\n' "$mem" | awk -F': ' '/^ *Type: (LP)?DDR/ { print $2; exit }')
	RAM_MHZ=$(printf '%s\n' "$mem" | awk -F': ' '/^ *Speed:/ && $2 + 0 > 0 { print int($2); exit }')
}

probe_macos() {
	OS_FAMILY="darwin"
	OS_NAME="$(sw_vers -productName 2>/dev/null) $(sw_vers -productVersion 2>/dev/null)"
	CPU_CORES=$(sysctl -n hw.logicalcpu 2>/dev/null)
	CPU_PHYSICAL=$(sysctl -n hw.physicalcpu 2>/dev/null)
	CPU_MODEL=$(mac_cpu_model)
	MEM_BYTES=$(sysctl -n hw.memsize 2>/dev/null)
	mac_ram_details
	collect_disks
	# Apple Silicon (also true under Rosetta): the GPU shares system RAM, so there is no separate VRAM.
	if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
		UNIFIED_MEMORY="true"
	else
		hz=$(sysctl -n hw.cpufrequency_max 2>/dev/null)
		if [ -n "$hz" ]; then CPU_MHZ=$((hz / 1000000)); fi
	fi

	# One "name|VRAM bytes|integrated" row per GPU. Apple Silicon has no VRAM line (unified memory);
	# Intel Macs list "VRAM (Total)" for discrete cards and "VRAM (Dynamic, Max)" for the iGPU.
	# Apple and Intel graphics borrow system RAM; AMD/NVIDIA cards do not.
	lines=$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': ' '
		function flush() {
			if (name != "") print name "|" bytes "|" ((name ~ /^(Apple|Intel)/) ? "true" : "false")
		}
		/Chipset Model/ { flush(); name = $2; bytes = "" }
		/VRAM/ {
			v = $2
			m = (v ~ /GB/) ? 1073741824 : (v ~ /MB/) ? 1048576 : 0
			if (m) bytes = int(v + 0) * m
		}
		END { flush() }')
	while IFS='|' read -r name bytes integrated; do
		[ -n "$name" ] && add_gpu "$name" "$bytes" "$integrated" ""
	done <<EOF
$lines
EOF
	VULKAN_JSON="null"
}

probe_bsd() {
	OS_FAMILY="bsd"
	OS_NAME=$(uname -sr)
	CPU_CORES=$(sysctl -n hw.ncpu 2>/dev/null)
	CPU_MODEL=$(sysctl -n hw.model 2>/dev/null)
	MEM_BYTES=$(sysctl -n hw.physmem 2>/dev/null)
	collect_disks
}

# Native Windows has no sh, so hand off to the PowerShell probe on the host.
run_windows_host() {
	if ! command -v powershell.exe >/dev/null 2>&1; then
		echo "canirungta: powershell.exe not found. Run the Windows probe from PowerShell: irm $ORIGIN/ps | iex" >&2
		return 1
	fi
	powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "\$env:CANIRUNGTA_ORIGIN='$ORIGIN'; irm $ORIGIN/ps | iex"
}

open_result() { # JSON as the only argument
	# Fragment is never sent to the server: the data stays in the browser.
	# URL-safe base64 without padding, straight after "#", to keep the link short.
	encoded=$(printf '%s' "$1" | base64 | tr -d '\n=' | tr '+/' '-_')
	url="$ORIGIN/#$encoded"
	echo "Result: $url"
	if [ -n "${CANIRUNGTA_NO_OPEN:-}" ]; then
		return 0
	fi
	# No terminal to ask on (CI, pipes): print only, never open silently.
	confirm_open || return 0
	if command -v xdg-open >/dev/null 2>&1; then
		xdg-open "$url" >/dev/null 2>&1 &
	elif command -v open >/dev/null 2>&1; then
		open "$url"
	fi
}

main() {
	kernel=$(uname -s 2>/dev/null)
	case "$kernel" in
		Linux)
			# WSL: GTA runs on the Windows host, so its hardware is the one that matters.
			if grep -qi microsoft /proc/version 2>/dev/null; then
				run_windows_host
				return
			fi
			probe_linux
			;;
		Darwin) probe_macos ;;
		FreeBSD | OpenBSD | NetBSD | DragonFly) probe_bsd ;;
		MINGW* | MSYS* | CYGWIN*)
			run_windows_host
			return
			;;
		*)
			echo "canirungta: unsupported OS '$kernel'" >&2
			return 1
			;;
	esac
	print_summary
	open_result "$(emit_json)"
}

main "$@"
