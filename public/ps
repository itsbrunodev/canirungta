# canirungta system probe for Windows. Read-only: no installs, no writes.
# Sends only hardware facts, no hostname or user names.
# Usage: irm https://canirungta.com/ps | iex
# Prints what it found, then asks before opening the result in a browser.
# Set $env:CANIRUNGTA_NO_OPEN = 1 to print the result link without asking or opening.
# Set $env:CANIRUNGTA_ORIGIN to point at another site (dev: http://localhost:4321).

# qwMemorySize is a QWORD on most drivers but a REG_BINARY byte array on some.
function ConvertTo-CanirungtaUInt64($value) {
	if ($value -is [byte[]]) {
		$padded = New-Object byte[] 8
		[Array]::Copy($value, $padded, [Math]::Min($value.Length, 8))
		return [BitConverter]::ToUInt64($padded, 0)
	}
	return [uint64]$value
}

function Get-CanirungtaVramEntries {
	# Win32_VideoController.AdapterRAM is 32-bit and caps at 4 GB, so read the driver registry key for the real size.
	$classKey = 'HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}'
	@(
		Get-ChildItem $classKey -ErrorAction SilentlyContinue |
			Where-Object { $_.PSChildName -match '^\d{4}$' } |
			ForEach-Object {
				$props = Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue
				if ($props.'HardwareInformation.qwMemorySize') {
					[pscustomobject]@{
						Desc = $props.DriverDesc
						DeviceId = $props.MatchingDeviceId
						Bytes = ConvertTo-CanirungtaUInt64 $props.'HardwareInformation.qwMemorySize'
					}
				}
			}
	)
}

# nvidia-smi ships with the NVIDIA driver and lists cards in bus order. It is the fallback when
# the registry has no size for a card (some drivers omit the key).
function Get-CanirungtaNvidiaVram {
	$smi = Get-Command nvidia-smi -ErrorAction SilentlyContinue
	if (-not $smi) { return @() }
	@(
		& $smi.Source --query-gpu=name,memory.total --format=csv,noheader,nounits 2>$null |
			ForEach-Object {
				$parts = $_ -split ',\s*'
				if ($parts.Count -ge 2 -and $parts[1] -match '^\d+$') {
					[pscustomobject]@{ Name = $parts[0].Trim(); Bytes = [uint64]$parts[1] * 1MB }
				}
			}
	)
}

# Windows reports NVIDIA drivers as 31.0.15.5123; the version on the box and in release notes is 551.23
# (the last five digits). Other vendors keep the raw string.
function Format-CanirungtaDriver($gpu) {
	$version = "$($gpu.DriverVersion)"
	if ($gpu.Name -match 'NVIDIA' -and $version -match '^\d+\.\d+\.(\d+)\.(\d+)$') {
		$digits = "$($Matches[1])$($Matches[2])"
		if ($digits.Length -ge 5) {
			$digits = $digits.Substring($digits.Length - 5)
			return '{0}.{1}' -f $digits.Substring(0, 3), $digits.Substring(3)
		}
	}
	if ($version) { return $version }
	return $null
}

function Get-CanirungtaGpus {
	$entries = Get-CanirungtaVramEntries
	$controllers = @(Get-CimInstance Win32_VideoController)
	$nvidia = @(Get-CanirungtaNvidiaVram)

	# Real GPUs sit on the PCI bus; remote-desktop, virtual-display and capture drivers do not.
	$physical = @($controllers | Where-Object { $_.PNPDeviceID -like 'PCI\*' })
	if ($physical.Count -gt 0) { $controllers = $physical }

	@(
		foreach ($gpu in $controllers) {
			# Match by hardware ID first so two cards with the same name keep separate figures.
			$match = $entries | Where-Object {
				$_.DeviceId -and $gpu.PNPDeviceID -like "$($_.DeviceId)*"
			} | Select-Object -First 1
			if (-not $match) {
				$match = $entries | Where-Object { $_.Desc -eq $gpu.Name } | Select-Object -First 1
			}

			$bytes = $null
			$smi = $nvidia | Where-Object { $gpu.Name -like "*$($_.Name)*" } | Select-Object -First 1
			if ($match) {
				$bytes = $match.Bytes
			} elseif ($smi) {
				$bytes = $smi.Bytes
			} elseif ($gpu.AdapterRAM -gt 0 -and $gpu.AdapterRAM -lt 4294967295) {
				# Under 4 GB the 32-bit field is still accurate.
				$bytes = [uint64]$gpu.AdapterRAM
			}

			# Integrated GPUs borrow system RAM, which the registry size does not reflect.
			# Radeon 680M / 780M / 8060S have no "RX"; discrete laptop cards (RX 6600M) do.
			$integrated = $gpu.Name -match 'Intel.*(UHD|Iris|HD Graphics|Xe Graphics|Arc(\(TM\))? Graphics)|Radeon(\(TM\))? Graphics|Radeon(\(TM\))? \d{3,4}[MS]\b|Radeon.*Vega \d+ Graphics|Adreno|Qualcomm'

			[ordered]@{
				name = "$($gpu.Name)".Trim()
				vramBytes = $bytes
				driver = Format-CanirungtaDriver $gpu
				integrated = [bool]$integrated
			}
		}
	)
}

# Drive letter -> 'ssd' | 'hdd'. NVMe is always flash; "Unspecified" (USB bridges, virtual disks,
# Storage Spaces) stays unknown rather than guessed.
function Get-CanirungtaDiskKinds {
	$kinds = @{}
	try {
		$physical = @(Get-PhysicalDisk -ErrorAction Stop)
		$partitions = @(Get-Partition -ErrorAction Stop | Where-Object { $_.DriveLetter })
		foreach ($part in $partitions) {
			$disk = $physical | Where-Object { $_.DeviceId -eq "$($part.DiskNumber)" } | Select-Object -First 1
			if (-not $disk) { continue }
			if ($disk.BusType -eq 'NVMe' -or $disk.MediaType -eq 'SSD') { $kinds["$($part.DriveLetter)"] = 'ssd' }
			elseif ($disk.MediaType -eq 'HDD') { $kinds["$($part.DriveLetter)"] = 'hdd' }
		}
	} catch { }
	return $kinds
}

# Local fixed drives only: the game may be installed off the system drive.
function Get-CanirungtaDisks {
	$kinds = Get-CanirungtaDiskKinds
	@(
		Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' |
			Where-Object { $_.Size } |
			ForEach-Object {
				[ordered]@{
					freeBytes = [uint64]$_.FreeSpace
					totalBytes = [uint64]$_.Size
					kind = $kinds["$($_.DeviceID)".Substring(0, 1)]
					label = "$($_.DeviceID)"
				}
			}
	)
}

# SMBIOS memory type codes for the common desktop and laptop kinds.
function Get-CanirungtaRam($cs) {
	$modules = @(Get-CimInstance Win32_PhysicalMemory -ErrorAction SilentlyContinue)
	$speeds = @($modules | ForEach-Object {
		if ($_.ConfiguredClockSpeed) { $_.ConfiguredClockSpeed } else { $_.Speed }
	} | Where-Object { $_ })
	# Mixed sticks run at the slowest one.
	$speed = if ($speeds.Count -gt 0) { ($speeds | Measure-Object -Minimum).Minimum } else { $null }
	$code = [int](($modules | ForEach-Object { if ($_.SMBIOSMemoryType) { $_.SMBIOSMemoryType } else { $_.MemoryType } } | Where-Object { $_ } | Select-Object -First 1))
	$type = switch ($code) {
		20 { 'DDR' }
		21 { 'DDR2' }
		24 { 'DDR3' }
		26 { 'DDR4' }
		29 { 'LPDDR3' }
		30 { 'LPDDR4' }
		34 { 'DDR5' }
		35 { 'LPDDR5' }
		default { $null }
	}
	return [ordered]@{
		totalBytes = [uint64]$cs.TotalPhysicalMemory
		unified = $false
		speedMhz = $speed
		type = $type
	}
}

function Get-CanirungtaProbe {
	$os = Get-CimInstance Win32_OperatingSystem
	$cs = Get-CimInstance Win32_ComputerSystem
	$processors = @(Get-CimInstance Win32_Processor)
	$logicalCores = ($processors | Measure-Object -Property NumberOfLogicalProcessors -Sum).Sum

	return [ordered]@{
		os = [ordered]@{
			family = 'windows'
			name = "$($os.Caption)".Trim()
			version = $os.Version
			arch = $os.OSArchitecture
		}
		cpu = [ordered]@{
			logicalCores = $logicalCores
			model = "$(($processors | Select-Object -First 1).Name)".Trim()
		}
		memory = [ordered]@{ totalBytes = [uint64]$cs.TotalPhysicalMemory; unified = $false }
		gpus = @(Get-CanirungtaGpus)
		disks = @(Get-CanirungtaDisks)
	}
}

function Format-CanirungtaGb($bytes) {
	if ($null -eq $bytes) { return 'unknown' }
	$gb = $bytes / 1GB
	if ($gb -lt 1) { return '{0:0} MB' -f [math]::Round($bytes / 1MB) }
	$rounded = [math]::Round($gb, 1)
	if ($rounded -eq [math]::Floor($rounded)) { return '{0:0} GB' -f $rounded }
	return '{0:0.0} GB' -f $rounded
}

# Mirrors the link: everything printed here is exactly what goes into it.
function Write-CanirungtaSummary($probe) {
	Write-Output 'canirungta probe (nothing is sent until you open the link; the data stays in the URL fragment)'
	Write-Output ''
	Write-Output ('  {0,-8}{1}' -f 'OS', $probe.os.name)

	$cpuDetail = @()
	if ($probe.cpu.physicalCores) { $cpuDetail += "$($probe.cpu.physicalCores) cores / $($probe.cpu.logicalCores) threads" }
	else { $cpuDetail += "$($probe.cpu.logicalCores) threads" }
	if ($probe.cpu.maxClockMhz) { $cpuDetail += ('up to {0:0.0} GHz' -f ($probe.cpu.maxClockMhz / 1000)) }
	Write-Output ('  {0,-8}{1} ({2})' -f 'CPU', $probe.cpu.model, ($cpuDetail -join ', '))

	$ram = Format-CanirungtaGb $probe.memory.totalBytes
	$ramDetail = (@($probe.memory.type, $(if ($probe.memory.speedMhz) { "$($probe.memory.speedMhz) MHz" })) | Where-Object { $_ }) -join ' '
	if ($ramDetail) { $ram = "$ram $ramDetail" }
	Write-Output ('  {0,-8}{1}' -f 'RAM', $ram)

	foreach ($gpu in $probe.gpus) {
		$detail = @()
		if ($null -ne $gpu.vramBytes) { $detail += "$(Format-CanirungtaGb $gpu.vramBytes) VRAM" }
		if ($gpu.integrated) { $detail += 'integrated' }
		if ($gpu.driver) { $detail += "driver $($gpu.driver)" }
		$suffix = if ($detail.Count -gt 0) { " ($($detail -join ', '))" } else { '' }
		Write-Output ('  {0,-8}{1}{2}' -f 'GPU', $gpu.name, $suffix)
	}
	foreach ($disk in $probe.disks) {
		$kind = switch ($disk.kind) { 'ssd' { ' SSD' } 'hdd' { ' HDD' } default { '' } }
		Write-Output ('  {0,-8}{1} free of {2}{3} ({4})' -f 'Disk', (Format-CanirungtaGb $disk.freeBytes), (Format-CanirungtaGb $disk.totalBytes), $kind, $disk.label)
	}
	Write-Output ('  {0,-8}{1}' -f 'Vulkan', 'not tested')
	Write-Output ''
}

function ConvertTo-CanirungtaJsonValue($value) {
	if ($null -eq $value) { return 'null' }
	return ConvertTo-Json -InputObject $value -Compress
}

function ConvertTo-CanirungtaMib($bytes) {
	if ($null -eq $bytes) { return 'null' }
	return [string][math]::Floor($bytes / 1MB)
}

function ConvertTo-CanirungtaNumOrNull($value) {
	if ($null -eq $value -or "$value" -eq '') { return 'null' }
	return [string][int64]$value
}

# Positional array, version 4 (same layout as public/sh), built by hand because ConvertTo-Json
# unrolls single-element arrays. The link carries MiB to stay short.
# [4, family, OS name, Windows major, 64-bit flag, RAM MiB, unified, logical cores,
#  [[gpu name, VRAM MiB, integrated, driver]], [[free MiB, "s"|"h"|null, total MiB, label]], vulkan,
#  CPU model, physical cores, max MHz, RAM MHz, RAM type]
function ConvertTo-CanirungtaLinkJson($probe) {
	$major = ($probe.os.version -split '\.')[0]
	$is64 = if ($probe.os.arch -match '64') { '1' } elseif ($probe.os.arch -match '32') { '0' } else { 'null' }
	$gpus = @($probe.gpus | ForEach-Object {
		$integrated = if ($_.integrated) { '1' } else { '0' }
		"[$(ConvertTo-CanirungtaJsonValue $_.name),$(ConvertTo-CanirungtaMib $_.vramBytes),$integrated,$(ConvertTo-CanirungtaJsonValue $_.driver)]"
	}) -join ','
	$disks = @($probe.disks | ForEach-Object {
		$kind = switch ($_.kind) { 'ssd' { '"s"' } 'hdd' { '"h"' } default { 'null' } }
		"[$(ConvertTo-CanirungtaMib $_.freeBytes),$kind,$(ConvertTo-CanirungtaMib $_.totalBytes),$(ConvertTo-CanirungtaJsonValue $_.label)]"
	}) -join ','
	return "[4,`"w`",$(ConvertTo-CanirungtaJsonValue $probe.os.name),$major,$is64,$(ConvertTo-CanirungtaMib $probe.memory.totalBytes),0,$($probe.cpu.logicalCores),[$gpus],[$disks],null,$(ConvertTo-CanirungtaJsonValue $probe.cpu.model),$(ConvertTo-CanirungtaNumOrNull $probe.cpu.physicalCores),$(ConvertTo-CanirungtaNumOrNull $probe.cpu.maxClockMhz),$(ConvertTo-CanirungtaNumOrNull $probe.memory.speedMhz),$(ConvertTo-CanirungtaJsonValue $probe.memory.type)]"
}

$probe = Get-CanirungtaProbe
$json = ConvertTo-CanirungtaLinkJson $probe
# URL-safe base64 without padding, straight after "#", to keep the link short.
$encoded = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($json)).TrimEnd('=').Replace('+', '-').Replace('/', '_')
$origin = if ($env:CANIRUNGTA_ORIGIN) { $env:CANIRUNGTA_ORIGIN } else { 'https://canirungta.com' }
$url = "$origin/#$encoded"

Write-CanirungtaSummary $probe
Write-Output "Result: $url"
if (-not $env:CANIRUNGTA_NO_OPEN) {
	# Non-interactive hosts (CI, piped) cannot answer: print only, never open silently.
	if ([Environment]::UserInteractive -and -not [Console]::IsInputRedirected) {
		$answer = Read-Host 'Open result in browser? [Y/n]'
		if ($answer -notmatch '^(n|no)$') {
			Start-Process $url
		}
	}
}
